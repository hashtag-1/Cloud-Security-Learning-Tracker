generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String         @id @default(uuid()) @db.Uuid
  email         String         @unique @db.VarChar(255)
  name          String         @db.VarChar(255)
  passwordHash  String         @db.Text
  createdAt     DateTime       @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime       @updatedAt @db.Timestamptz(6)

  studySessions StudySession[]
  labs          Lab[]
  projects      Project[]
  notes         KnowledgeNote[]
  certifications Certification[]
  roadmapPhases RoadmapPhase[]
  sessions      Session[]
}

model RoadmapPhase {
  id              String          @id @default(uuid()) @db.Uuid
  order           Int
  title           String          @db.VarChar(255)
  objective       String?         @db.Text
  estimatedWeeks  Int?
  completionPct   Float           @default(0)
  createdAt       DateTime        @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime        @updatedAt @db.Timestamptz(6)

  userId          String          @db.Uuid
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  topics          RoadmapTopic[]

  @@unique([userId, order])
  @@index([userId])
}

model RoadmapTopic {
  id              String          @id @default(uuid()) @db.Uuid
  order           Int
  title           String          @db.VarChar(255)
  objective       String?         @db.Text
  status          String          @default("NOT_STARTED") @db.VarChar(30)
  completionPct   Float           @default(0)
  createdAt       DateTime        @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime        @updatedAt @db.Timestamptz(6)

  phaseId         String          @db.Uuid
  phase           RoadmapPhase    @relation(fields: [phaseId], references: [id], onDelete: Cascade)
  microtopics     RoadmapMicrotopic[]

  @@unique([phaseId, order])
  @@index([phaseId])
}

model RoadmapMicrotopic {
  id              String          @id @default(uuid()) @db.Uuid
  order           Int
  title           String          @db.VarChar(255)
  description     String?         @db.Text
  depth           String?         @db.VarChar(20)
  status          String          @default("NOT_STARTED") @db.VarChar(30)
  createdAt       DateTime        @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime        @updatedAt @db.Timestamptz(6)

  topicId         String          @db.Uuid
  topic           RoadmapTopic    @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@unique([topicId, order])
  @@index([topicId])
}

model StudySession {
  id              String          @id @default(uuid()) @db.Uuid
  date            DateTime        @db.Date
  duration        Int             // in minutes
  topicsStudied   String          @db.Text
  notes           String?         @db.Text
  mood            String?         @db.VarChar(20)
  productivityRating Int?          @db.SmallInt
  createdAt       DateTime        @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime        @updatedAt @db.Timestamptz(6)

  userId          String          @db.Uuid
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([date])
}

model Lab {
  id              String          @id @default(uuid()) @db.Uuid
  name            String          @db.VarChar(255)
  category        String          @db.VarChar(100)
  difficulty      String          @default("MEDIUM") @db.VarChar(20)
  status          String          @default("PLANNED") @db.VarChar(30)
  notes           String?         @db.Text
  skillsLearned   String[]        @db.VarChar(255)
  createdAt       DateTime        @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime        @updatedAt @db.Timestamptz(6)

  userId          String          @db.Uuid
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
}

model Project {
  id              String          @id @default(uuid()) @db.Uuid
  name            String          @db.VarChar(255)
  description     String?         @db.Text
  githubUrl       String?         @db.Text
  technologies    String[]        @db.VarChar(255)
  status          String          @default("PLANNED") @db.VarChar(30)
  createdAt       DateTime        @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime        @updatedAt @db.Timestamptz(6)

  userId          String          @db.Uuid
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
}

model KnowledgeNote {
  id              String          @id @default(uuid()) @db.Uuid
  title           String          @db.VarChar(255)
  content         String          @db.Text
  type            String          @default("NOTE") @db.VarChar(20)
  createdAt       DateTime        @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime        @updatedAt @db.Timestamptz(6)

  userId          String          @db.Uuid
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  tags            NoteTag[]
}

model Certification {
  id              String          @id @default(uuid()) @db.Uuid
  name            String          @db.VarChar(255)
  provider        String?         @db.VarChar(100)
  status          String          @default("NOT_STARTED") @db.VarChar(30)
  score           String?         @db.VarChar(50)
  dateObtained    DateTime?       @db.Date
  createdAt       DateTime        @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime        @updatedAt @db.Timestamptz(6)

  userId          String          @db.Uuid
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Tag {
  id              String          @id @default(uuid()) @db.Uuid
  name            String          @unique @db.VarChar(50)
  color           String          @default("blue") @db.VarChar(20)
  createdAt       DateTime        @default(now()) @db.Timestamptz(6)

  notes           NoteTag[]

  @@index([name])
}

model NoteTag {
  noteId          String          @db.Uuid
  tagId           String          @db.Uuid

  note            KnowledgeNote   @relation(fields: [noteId], references: [id], onDelete: Cascade)
  tag             Tag             @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([noteId, tagId])
}

model Session {
  id              String          @id @default(uuid()) @db.Uuid
  sessionToken    String          @unique @db.Text
  userId          String          @db.Uuid
  expiresAt       DateTime        @db.Timestamptz(6)
  createdAt       DateTime        @default(now()) @db.Timestamptz(6)

  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
